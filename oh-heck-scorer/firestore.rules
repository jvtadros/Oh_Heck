rules_version = '2';

// Security model for v1 (no real accounts, just Firebase Anonymous Auth):
// - A device signs in anonymously on first load and reuses that uid as its
//   player id (see src/lib/firebase.ts). Every authenticated request below
//   is gated on request.auth != null, i.e. on having *some* Firebase session.
// - `list` is disabled so room codes can't be enumerated; a client can only
//   ever read a game by knowing its exact code (the document id).
// - `create` only allows a fresh lobby doc where the creator is the sole
//   player and the host.
// - `update` allows the host, any existing player, or someone joining an
//   open lobby — but does not deeply validate every field (e.g. an existing
//   player could technically overwrite another player's bid). That's an
//   accepted trade-off for a casual, no-login scoring app; see README for
//   how to harden this further (e.g. Cloud Functions as the only writer).
service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{roomId} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.code == roomId
        && request.resource.data.status == 'lobby'
        && request.resource.data.currentRound == null
        && request.resource.data.roundHistory.size() == 0
        && request.resource.data.players.keys().hasOnly([request.auth.uid]);

      allow update: if request.auth != null
        && identityIsImmutable()
        && (isHost() || isExistingPlayer() || isJoiningOpenLobby());

      allow delete: if false;

      function identityIsImmutable() {
        return request.resource.data.hostId == resource.data.hostId
          && request.resource.data.code == resource.data.code;
      }

      function isHost() {
        return request.auth.uid == resource.data.hostId;
      }

      function isExistingPlayer() {
        return request.auth.uid in resource.data.players;
      }

      function isJoiningOpenLobby() {
        return resource.data.status == 'lobby'
          && !(request.auth.uid in resource.data.players)
          && request.auth.uid in request.resource.data.players;
      }
    }
  }
}
